# =============================================================================
# Vonage MCP Server 設定
#
# 実行例: node --env-file=.env dist/index.js
# =============================================================================

# -----------------------------------------------------------------------------
# Vonage の資格情報
# -----------------------------------------------------------------------------

# Vonage Application ID (Dashboard の Applications で確認)
# 注意: これは公開識別子であり秘密情報ではありません。認証には使えません
VONAGE_APPLICATION_ID=

# 秘密鍵ファイルのパス (未設定なら ./private.key)
VONAGE_PRIVATE_KEY_PATH=./private.key

# 音声通話の発信元番号 (E.164形式)。ENABLE_VOICE=true の場合は必須
VONAGE_VOICE_FROM=

# -----------------------------------------------------------------------------
# 機能の有効化 (capability トグル)
#
# 既定ではツールが1つも公開されません。使う機能だけを true にしてください。
# 有効な値は true / false のみ。大文字小文字を区別します
# (True / TRUE / 1 / yes はすべて起動エラー)
# -----------------------------------------------------------------------------

# send_sms / get_sms_status
ENABLE_SMS=false

# make_voice_call / get_call_status (VONAGE_VOICE_FROM が必須になります)
ENABLE_VOICE=false

# -----------------------------------------------------------------------------
# 宛先のガードレール
# -----------------------------------------------------------------------------

# 送信・架電を許可する国番号 (カンマ区切り、+ の有無は問わない)。既定は日本のみ
# 実在しない国番号を書くと起動エラーになります
# * を指定すると制限を外せます (非推奨)
ALLOWED_COUNTRY_CODES=81

# 送信・架電を許可する宛先番号のホワイトリスト (カンマ区切り)
# 未設定なら制限なし。設定したのに有効な番号が1件も無い場合はすべて拒否します
# ALLOWED_NUMBERS=+819012345678,+819087654321

# 0990 (情報料代理徴収) / 0570 (ナビダイヤル) / 0180 (テレドーム) への
# 送信・架電を許可する。既定は禁止
ALLOW_PREMIUM_NUMBERS=false

# 緊急通報番号 (110 / 119 / 118) は常にブロックされ、環境変数では緩められません

# -----------------------------------------------------------------------------
# レートリミット
#
# 「ツール呼び出し回数」ではなく「送信件数」で消費されます
# -----------------------------------------------------------------------------

# 1時間あたりの送信・架電件数の上限 (0〜10000 の整数)
# SMS と架電の【合計】に対する上限です (ツールごとの別枠ではありません)
# 注意: 0 は「無制限」ではなく「すべて拒否」です  v2.0.0
RATE_LIMIT_PER_HOUR=5

# チャネル別の追加上限。未設定なら RATE_LIMIT_PER_HOUR に委ねます
# SMS_RATE_LIMIT_PER_HOUR=
# VOICE_RATE_LIMIT_PER_HOUR=

# レートリミットを完全に無効化する (危険。本番環境では使わないこと)
# 起動のたびに警告が出ます
DISABLE_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# HTTP トランスポート (stdio のみで使う場合は不要)
# -----------------------------------------------------------------------------

# /mcp エンドポイントの Bearer トークン。16文字以上 (短いと起動エラー)
# 生成例: openssl rand -hex 32
# 未設定の場合、HTTPサーバーは 127.0.0.1 でのみ待ち受けます
# MCP_AUTH_TOKEN=

# 認証を上流 (Cloud Run IAM / API Gateway) に任せる場合のみ true
# 手前で認証していない環境で有効にすると完全に無防備になります
TRUST_UPSTREAM_AUTH=false

# 待ち受けアドレス
# 既定: 認証があれば 0.0.0.0、無ければ 127.0.0.1
# 認証なしで外部アドレスを指定すると起動時にエラーになります
# BIND_HOST=

# 待ち受けポート (1〜65535)
PORT=3000

# -----------------------------------------------------------------------------
# OAuth 2.1 リソースサーバーモード (ChatGPT / Gemini Enterprise のコネクタ向け)
#
# MCP 仕様が定める認可の標準は OAuth 2.1 です。上の MCP_AUTH_TOKEN による
# 静的 Bearer は仕様には無く、基盤が任意ヘッダを設定させてくれる場合にだけ
# 使えます。ChatGPT や Gemini Enterprise のコネクタは「OAuth か認証なし」の
# 2択しか出さないため、それらに繋ぐにはここを設定します
#
# このサーバーが担うのはリソースサーバーだけです。認可サーバーは外部の IdP
# (Auth0 / Okta / Entra ID / Keycloak など) を使ってください
#
# 下の3つは【揃っている必要があります】。1つでも欠けると起動エラーです
# (部分設定を黙って無視すると、OAuth にしたつもりのサーバーが実は静的
#  トークンで動いていた、という状態ができるため)
# -----------------------------------------------------------------------------

# 認可サーバーの issuer。トークンの iss と照合します
# https のみ (ループバック = localhost / 127.0.0.1 / [::1] だけ http も可)
# OAUTH_ISSUER=https://your-tenant.example.com

# この MCP サーバーの正規 URI (RFC 8707 / RFC 9728 の resource)
# トークンの aud にこの値が入っていることを検証します
# フラグメントとクエリは指定できません
# OAUTH_RESOURCE=https://vonage-mcp.example.com/mcp

# アクセストークンの署名鍵の取得先
# IdP の /.well-known/openid-configuration にある jwks_uri を使います
# OAUTH_JWKS_URI=https://your-tenant.example.com/.well-known/jwks.json

# トークンの aud に期待する値。既定は OAUTH_RESOURCE と同じ
# IdP の API 識別子が URI と異なる場合だけ設定します
# OAUTH_AUDIENCE=

# 保護リソースメタデータに載せる scope (カンマ区切り)
# OAUTH_SCOPES_SUPPORTED=

# /mcp を呼ぶために必須の scope。無いトークンは 403 insufficient_scope
# OAUTH_REQUIRED_SCOPE=

# RFC 9068 の typ: at+jwt を必須にする (true / false)。【既定は true】
# false にする場合は OAUTH_REQUIRED_SCOPE が必須になります (下記)
# OAUTH_REQUIRE_AT_JWT=true

# 【ID トークンをアクセストークンとして受け取らないための設定は必須です】
#
#   ID トークンの aud はクライアント識別子です。同じ IdP が同じ鍵・同じ issuer で
#   両方を発行する構成で OAUTH_AUDIENCE をクライアント識別子に合わせると、
#   iss / aud / exp では区別できません。ログインできるだけの利用者が、
#   API の委譲を受けないまま SMS を送れます
#
#   そのため「アクセストークンであることを積極的に示すもの」を1つ要求します。
#   次のどちらかが必要で、両方欠けていると起動時にエラーになります:
#
#     - OAUTH_REQUIRE_AT_JWT=true (既定)
#       … IdP が typ: at+jwt を付ける場合 (Auth0 など)
#     - OAUTH_REQUIRE_AT_JWT=false かつ OAUTH_REQUIRED_SCOPE=...
#       … IdP が typ を付けない場合 (Keycloak / Entra ID など)
#         ID トークンは API の scope を運びません
#
#   あわせて、OAUTH_AUDIENCE は API / リソースの識別子にしてください

# 注意: http (http://localhost / http://127.0.0.1 / http://[::1]) が使えるのは
#       手元での確認だけです。issuer / resource / JWKS のいずれかが http の場合、
#       BIND_HOST を指定しなければ 127.0.0.1 で待ち受けます。外部アドレスを
#       指定すると起動時にエラーになります (MCP_AUTH_TOKEN を併用していても同じ)

# 注意: MCP_AUTH_TOKEN と併用すると【どちらの資格情報でも通ります】
#       (起動のたびに警告が出ます)。OAuth だけに絞るなら MCP_AUTH_TOKEN を
#       削除してください

# -----------------------------------------------------------------------------
# Webhook (配信ステータス受信)
# -----------------------------------------------------------------------------

# Status Webhook の署名検証に使う Signature Secret【推奨】
# Vonage Dashboard の Settings → API settings で取得できます
# VONAGE_API_SIGNATURE_SECRET=

# 署名検証が使えない環境向けの代替 (x-webhook-secret ヘッダーと照合)
# VONAGE_API_SIGNATURE_SECRET が設定されている場合は使われません
# VONAGE_WEBHOOK_SECRET=

# 署名付き Webhook の iat / exp に許す時刻のずれ (秒、1〜3600)
WEBHOOK_MAX_AGE_SECONDS=300

# 上記2つのシークレットがどちらも未設定の場合、
# Status Webhook エンドポイントは 503 を返して無効化されます (fail-closed)

# -----------------------------------------------------------------------------
# デバッグ
# -----------------------------------------------------------------------------

# true でデバッグログを stderr に出力
DEBUG=false

# デバッグログの出力先ファイル (任意)
# LOG_FILE=

ALLOWED_ORIGINS=
ALLOWED_HOSTS=
SMS_SEGMENT_LIMIT_PER_HOUR=
SMS_MAX_SEGMENTS=3

# 音声の着信時に読み上げる案内（着信は処理しない方針のため、既定は断りの案内）
# 1000文字以内（発信の読み上げと同じ上限）。着信は誰でも掛けられるため、長い案内文は
# そのまま通話時間と音声合成の課金になります。超過すると起動時にエラーで停止します
# VOICE_INBOUND_MESSAGE=こちらは発信専用の番号です。
